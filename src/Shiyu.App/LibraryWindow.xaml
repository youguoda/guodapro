<Window x:Class="Shiyu.App.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="拾语 · 历史" Height="620" Width="900"
        WindowStartupLocation="CenterScreen"
        FontSize="13">
    <Window.Resources>
        <Style x:Key="Toolbutton" TargetType="Button">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="76" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="84" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <TextBox x:Name="SearchBox" Padding="7,6" VerticalContentAlignment="Center"
                         TextChanged="OnSearchTextChanged" />
                <TextBlock x:Name="SearchPlaceholder" Text="搜索历史…" Margin="10,0,0,0"
                           Opacity="0.45" IsHitTestVisible="False" VerticalAlignment="Center" />
            </Grid>

            <TextBlock x:Name="CountLabel" Grid.Column="1" Margin="12,0,2,0"
                       VerticalAlignment="Center" Opacity="0.6" />
        </Grid>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,44,0,10"
                    VerticalAlignment="Top">
            <TextBlock Text="类型" VerticalAlignment="Center" Opacity="0.6" FontSize="12" />
            <ComboBox x:Name="KindFilter" Width="92" Margin="6,0,14,0" SelectedIndex="0"
                      SelectionChanged="OnFilterChanged">
                <ComboBoxItem Content="全部" />
                <ComboBoxItem Content="文本" />
                <ComboBoxItem Content="图片" />
            </ComboBox>

            <TextBlock Text="日期" VerticalAlignment="Center" Opacity="0.6" FontSize="12" />
            <DatePicker x:Name="FilterFrom" Width="124" Margin="6,0"
                        SelectedDateChanged="OnFilterChanged" />
            <TextBlock Text="至" VerticalAlignment="Center" Opacity="0.6" FontSize="12" />
            <DatePicker x:Name="FilterTo" Width="124" Margin="6,0"
                        SelectedDateChanged="OnFilterChanged" />

            <TextBlock Text="标签" VerticalAlignment="Center" Opacity="0.6" FontSize="12" Margin="10,0,0,0" />
            <ComboBox x:Name="TagFilter" Width="118" Margin="6,0,10,0"
                      SelectionChanged="OnFilterChanged" />

            <Button Content="清除筛选" FontSize="11" Padding="9,3"
                    Cursor="Hand" Click="OnClearFilters" />
        </StackPanel>

        <ListBox x:Name="EntryList" Grid.Row="1"
                 SelectionMode="Extended"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.ScrollChanged="OnListScrolled"
                 MouseDoubleClick="OnCopySelected"
                 PreviewMouseMove="OnListMouseMove"
                 SelectionChanged="OnSelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="3,5">
                        <Border Width="88" Height="56" Margin="0,0,10,0" CornerRadius="3"
                                Background="#14000000" Visibility="{Binding ThumbnailVisibility}">
                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📌" FontSize="11" Margin="0,0,5,0"
                                           Visibility="{Binding PinVisibility}" />
                                <TextBlock Text="{Binding Preview}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Text="{Binding Meta}" FontSize="11" Opacity="0.55" Margin="0,3,0,0" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="EmptyLabel" Grid.Row="1" Text="还没有记录"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Opacity="0.45" Visibility="Collapsed" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="复制" Style="{StaticResource Toolbutton}" Click="OnCopySelected" />
            <Button Content="删除" Style="{StaticResource Toolbutton}" Click="OnDeleteSelected" />
            <Button x:Name="PinButton" Content="置顶" Style="{StaticResource Toolbutton}" Click="OnTogglePin" />
            <Button Content="清空全部历史" Style="{StaticResource Toolbutton}" Click="OnClearAll" />

            <TextBox x:Name="TagBox" Width="112" Margin="14,0,6,0" Padding="6,4"
                     VerticalContentAlignment="Center" KeyDown="OnTagBoxKeyDown" />
            <Button Content="加标签" Style="{StaticResource Toolbutton}" Click="OnAddTag" />
            <Button Content="去标签" Style="{StaticResource Toolbutton}" Click="OnRemoveTag" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0"
                    HorizontalAlignment="Right">
            <TextBlock Text="对所选条目：" VerticalAlignment="Center" Opacity="0.6" FontSize="12" />
            <Button Content="总结" Tag="Summarise" Style="{StaticResource Toolbutton}" Click="OnRunAgentAction" />
            <Button Content="合并成笔记" Tag="MergeIntoNote" Style="{StaticResource Toolbutton}" Click="OnRunAgentAction" />
            <Button Content="改写" Tag="Rewrite" Style="{StaticResource Toolbutton}" Click="OnRunAgentAction" />
            <Button Content="建议标签" Tag="SuggestTags" Style="{StaticResource Toolbutton}" Click="OnRunAgentAction" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="按时间段删除：" VerticalAlignment="Center" Opacity="0.7" />
            <DatePicker x:Name="RangeFrom" Width="130" Margin="6,0" />
            <TextBlock Text="至" VerticalAlignment="Center" />
            <DatePicker x:Name="RangeTo" Width="130" Margin="6,0" />
            <Button Content="删除该时间段" Style="{StaticResource Toolbutton}" Click="OnDeleteRange" />
            <TextBlock x:Name="StatusLabel" VerticalAlignment="Center" Margin="10,0,0,0" Opacity="0.6" />
        </StackPanel>

        <Border x:Name="AgentPanel" Grid.Row="4" Margin="0,12,0,0" Padding="11,9"
                CornerRadius="6" Background="#0D000000" Visibility="Collapsed">
            <StackPanel>
                <DockPanel LastChildFill="False" Margin="0,0,0,7">
                    <TextBlock x:Name="AgentTitle" DockPanel.Dock="Left" FontSize="12"
                               Opacity="0.7" VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right" Content="✕" FontSize="11" Padding="6,1"
                            BorderThickness="0" Background="Transparent" Cursor="Hand"
                            Click="OnCloseAgentPanel" />
                    <Button x:Name="AgentCopyButton" DockPanel.Dock="Right" Content="复制结果"
                            FontSize="11" Padding="9,2" Margin="0,0,6,0" Cursor="Hand"
                            Click="OnCopyAgentOutput" />
                </DockPanel>

                <TextBlock x:Name="AgentOutput" TextWrapping="Wrap" FontSize="12"
                           MaxHeight="150" LineHeight="19" />

                <ItemsControl x:Name="SuggestedTags" Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}" Margin="0,0,6,6" Padding="8,2" FontSize="11"
                                    Cursor="Hand" Click="OnAcceptSuggestedTag"
                                    ToolTip="点击把这个标签加到所选条目" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</Window>
