<Window x:Class="Shiyu.App.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="拾语 · 历史" Height="620" Width="1150" MinWidth="820"
        SizeChanged="OnWindowSizeChanged"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen"
        FontSize="{DynamicResource Type.Body}"
        TextElement.FontFamily="{DynamicResource Font.Ui}"
        TextElement.Foreground="{DynamicResource Brush.Text}">
    <WindowChrome.WindowChrome>
        <!--
          Borderless but resizable: the chrome only provides the resize
          border hot-zone; the caption (drag/close/maximize) is ours, and
          its presence fixes maximized windows covering the taskbar.
        -->
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="Toolbutton" TargetType="Button">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="76" />
        </Style>
    </Window.Resources>

    <!--
      The floating Win11 shell (ticket 33): translucent brand tint over DWM
      Mica, rounded, one soft shadow, with our own titlebar. Margin carries
      the shadow and collapses to zero when maximized.
    -->
    <Border x:Name="Shell" Margin="10" CornerRadius="{DynamicResource Radius.Window}"
            Background="{DynamicResource Brush.SurfaceMaterial}"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
        <Border.Effect>
            <StaticResource ResourceKey="Shadow.Floating"/>
        </Border.Effect>
        <DockPanel>
            <Border x:Name="TitleBar" DockPanel.Dock="Top" Height="40"
                    Background="Transparent" MouseLeftButtonDown="OnTitleBarDrag">
                <DockPanel LastChildFill="False" Margin="14,0,0,0">
                    <TextBlock Text="拾语 · 历史" VerticalAlignment="Center"
                               FontSize="{DynamicResource Type.Body}"
                               Foreground="{DynamicResource Brush.TextSecondary}"/>
                    <Button x:Name="MinimizeButton" DockPanel.Dock="Right" Width="34" Height="30"
                            Content="&#xE921;" FontFamily="{DynamicResource Font.Icon}" FontSize="{DynamicResource Size.IconXs}"
                            Style="{StaticResource CaptionButtonStyle}" Click="OnMinimizeClick" ToolTip="最小化"/>
                    <Button x:Name="MaximizeButton" DockPanel.Dock="Right" Width="34" Height="30"
                            Content="&#xE922;" FontFamily="{DynamicResource Font.Icon}" FontSize="{DynamicResource Size.IconXs}"
                            Style="{StaticResource CaptionButtonStyle}" Click="OnMaximizeRestoreClick" ToolTip="最大化"/>
                    <Button x:Name="CloseButton" DockPanel.Dock="Right" Width="40" Height="30"
                            Content="&#xE8BB;" FontFamily="{DynamicResource Font.Icon}" FontSize="{DynamicResource Size.IconXs}"
                            Style="{StaticResource CaptionButtonStyle}" Click="OnCloseClick" ToolTip="关闭"/>
                </DockPanel>
            </Border>

            <Grid Margin="14,4,14,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="84" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <TextBox x:Name="SearchBox" Padding="7,6" VerticalContentAlignment="Center"
                         TextChanged="OnSearchTextChanged" />
                <TextBlock x:Name="SearchPlaceholder" Text="搜索历史…" Margin="10,0,0,0"
                           Foreground="{DynamicResource Brush.TextTertiary}"
                           IsHitTestVisible="False" VerticalAlignment="Center" />
            </Grid>

            <TextBlock x:Name="CountLabel" Grid.Column="1" Margin="12,0,2,0"
                       VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" />
        </Grid>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,44,0,10"
                    VerticalAlignment="Top">
            <TextBlock Text="类型" VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       FontSize="{DynamicResource Type.Body}" />
                <ComboBox x:Name="KindFilter" Width="92" Margin="6,0,14,0" SelectedIndex="0"
                          SelectionChanged="OnFilterChanged">
                    <ComboBoxItem Content="全部" />
                    <ComboBoxItem Content="文本" />
                    <ComboBoxItem Content="图片" />
                    <ComboBoxItem Content="文件" />
                </ComboBox>

            <TextBlock Text="日期" VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       FontSize="{DynamicResource Type.Body}" />
            <DatePicker x:Name="FilterFrom" Width="124" Margin="6,0"
                        SelectedDateChanged="OnFilterChanged" />
            <TextBlock Text="至" VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       FontSize="{DynamicResource Type.Body}" />
            <DatePicker x:Name="FilterTo" Width="124" Margin="6,0"
                        SelectedDateChanged="OnFilterChanged" />

            <TextBlock Text="标签" VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       FontSize="{DynamicResource Type.Body}" Margin="10,0,0,0" />
            <ComboBox x:Name="TagFilter" Width="118" Margin="6,0,10,0"
                      SelectionChanged="OnFilterChanged" />

            <TextBlock Text="子类型" VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       FontSize="{DynamicResource Type.Body}" />
            <ComboBox x:Name="SubtypeFilter" Width="76" Margin="6,0,10,0" SelectedIndex="0"
                      SelectionChanged="OnFilterChanged">
                <ComboBoxItem Content="全部" />
                <ComboBoxItem Content="链接" />
                <ComboBoxItem Content="邮箱" />
                <ComboBoxItem Content="颜色" />
                <ComboBoxItem Content="路径" />
            </ComboBox>

            <Button Content="清除筛选" FontSize="{DynamicResource Type.Body}" Padding="10,4"
                    Cursor="Hand" Click="OnClearFilters" />
        </StackPanel>

        <!--
          Wide windows get the two-column layout: the list on the left, the
          selected entry in full on the right (single click previews, double
          click copies). Below 1080 the detail column folds away entirely.
        -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListColumn" Width="*" />
                <ColumnDefinition x:Name="DetailColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
        <ListBox x:Name="EntryList"
                 SelectionMode="Extended"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.ScrollChanged="OnListScrolled"
                 MouseDoubleClick="OnCopySelected"
                 PreviewMouseMove="OnListMouseMove"
                 SelectionChanged="OnSelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="3,5">
                        <Border Width="88" Height="56" Margin="0,0,10,0"
                                CornerRadius="{DynamicResource Radius.Thumb}"
                                Background="{DynamicResource Brush.SurfaceSubtle}"
                                Visibility="{Binding ThumbnailVisibility}">
                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Image Source="{Binding Icon}" Visibility="{Binding IconVisibility}"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <Border CornerRadius="{DynamicResource Radius.Thumb}"
                                            Background="{DynamicResource Brush.Accent}"
                                            Visibility="{Binding FallbackIconVisibility}">
                                        <TextBlock Text="拾" FontSize="{DynamicResource Size.IconXs}"
                                                   Foreground="{DynamicResource Brush.TextOnAccent}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="📌" FontSize="{DynamicResource Size.IconXs}"
                                           Margin="0,0,6,0" Visibility="{Binding PinVisibility}" />
                                <TextBlock Text="{Binding Preview}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Text="{Binding Meta}" FontSize="{DynamicResource Type.Caption}"
                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
            </Grid>
            <Border x:Name="DetailHost" Grid.Column="1" Margin="14,0,0,0"
                    Padding="14,12" CornerRadius="{DynamicResource Radius.Card}"
                    Background="{DynamicResource Brush.SurfaceSubtle}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                    Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="DetailMeta" FontSize="{DynamicResource Type.Caption}"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   TextWrapping="Wrap" />
                        <Image x:Name="DetailImage" MaxHeight="300" Margin="0,10,0,0"
                               HorizontalAlignment="Left" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="Collapsed" />
                        <!-- 管理窗详情栏正文：被阅读的内容，Type.Content 18（ADR-0012 排版 2）。 -->
                        <TextBox x:Name="DetailText" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 MinHeight="100" MaxHeight="380" Margin="0,10,0,0"
                                 Background="Transparent" BorderThickness="0"
                                 FontSize="{DynamicResource Type.Content}"
                                 FontFamily="{DynamicResource Font.Mono}" />
                        <ItemsControl x:Name="DetailFiles" Margin="0,10,0,0" Visibility="Collapsed">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="{DynamicResource Type.ContentMono}"
                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                               TextTrimming="CharacterEllipsis" Margin="0,2"
                                               ToolTip="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock x:Name="EmptyLabel" Grid.Row="1" Text="还没有记录"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{DynamicResource Brush.TextTertiary}" Visibility="Collapsed" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <!-- Safe actions first, destructive last and set apart: distance
                 and colour are the warning before the confirmation dialog. -->
            <Button Content="复制" Style="{StaticResource Toolbutton}" Click="OnCopySelected" />
            <Button x:Name="PinButton" Content="置顶" Style="{StaticResource Toolbutton}" Click="OnTogglePin" />
            <TextBox x:Name="TagBox" Width="112" Margin="14,0,6,0" Padding="6,4"
                     VerticalContentAlignment="Center" KeyDown="OnTagBoxKeyDown" />
            <Button x:Name="AddTagButton" Content="加标签" Style="{StaticResource Toolbutton}" Click="OnAddTag" />
            <Button x:Name="RemoveTagButton" Content="去标签" Style="{StaticResource Toolbutton}" Click="OnRemoveTag" />

            <Border Width="1" Height="22" Margin="12,0,12,0"
                    Background="{DynamicResource Brush.Border}" />

            <Button x:Name="DeleteSelectedButton" Content="删除" Style="{StaticResource Toolbutton}" Click="OnDeleteSelected" />
            <Button x:Name="ClearAllButton" Content="清空全部历史" Style="{StaticResource Toolbutton}" Click="OnClearAll" />
            <Button x:Name="UndoDeleteButton" Content="撤销删除" Style="{StaticResource Toolbutton}"
                    Margin="0,0,0,0" Click="OnUndoDelete" IsEnabled="False"
                    ToolTip="恢复刚删除的条目（5 秒内）"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0"
                    HorizontalAlignment="Right">
            <TextBlock Text="对所选条目：" VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       FontSize="{DynamicResource Type.Body}" />
            <Button x:Name="AgentSummariseButton" Content="总结" Tag="Summarise" Style="{StaticResource Toolbutton}" Click="OnRunAgentAction" />
            <Button x:Name="AgentMergeButton" Content="合并成笔记" Tag="MergeIntoNote" Style="{StaticResource Toolbutton}" Click="OnRunAgentAction" />
            <Button x:Name="AgentRewriteButton" Content="改写" Tag="Rewrite" Style="{StaticResource Toolbutton}" Click="OnRunAgentAction" />
            <Button x:Name="AgentTagsButton" Content="建议标签" Tag="SuggestTags" Style="{StaticResource Toolbutton}" Click="OnRunAgentAction" />
            <Button x:Name="TranslateBatchButton" Content="批量翻译存入历史"
                    Style="{StaticResource Toolbutton}" Click="OnTranslateBatch"
                    ToolTip="把选中的条目逐条翻译成设置里的译文语言，结果存为带「译」标的关联条目"/>
            <Button x:Name="TranslateCancelButton" Content="取消翻译" Style="{StaticResource Toolbutton}"
                    Visibility="Collapsed" Click="OnCancelTranslateBatch"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="按时间段删除：" VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.TextSecondary}" />
            <DatePicker x:Name="RangeFrom" Width="130" Margin="6,0" />
            <TextBlock Text="至" VerticalAlignment="Center" />
            <DatePicker x:Name="RangeTo" Width="130" Margin="6,0" />
            <Button Content="删除该时间段" Style="{StaticResource Toolbutton}" Click="OnDeleteRange" />
            <TextBlock x:Name="StatusLabel" VerticalAlignment="Center" Margin="10,0,0,0"
                       Foreground="{DynamicResource Brush.TextSecondary}" />
        </StackPanel>

        <Border x:Name="AgentPanel" Grid.Row="4" Margin="0,12,0,0" Padding="12,10"
                CornerRadius="{DynamicResource Radius.Small}"
                Background="{DynamicResource Brush.SurfaceSubtle}" Visibility="Collapsed">
            <StackPanel>
                <DockPanel LastChildFill="False" Margin="0,0,0,8">
                    <TextBlock x:Name="AgentTitle" DockPanel.Dock="Left"
                               FontSize="{DynamicResource Type.Body}"
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right" Content="✕"
                            FontSize="{DynamicResource Type.Caption}" Padding="6,2"
                            BorderThickness="0" Background="Transparent" Cursor="Hand"
                            Click="OnCloseAgentPanel" />
                    <Button x:Name="AgentCopyButton" DockPanel.Dock="Right" Content="复制结果"
                            FontSize="{DynamicResource Type.Body}" Padding="10,2"
                            Margin="0,0,6,0" Cursor="Hand" Click="OnCopyAgentOutput" />
                </DockPanel>

                <!-- AI 结果是被阅读的正文：Type.Content 18/31（ADR-0012 排版 2）。 -->
                <TextBlock x:Name="AgentOutput" TextWrapping="Wrap"
                           FontSize="{DynamicResource Type.Content}"
                           MaxHeight="150" LineHeight="{DynamicResource Line.Content}"
                           LineStackingStrategy="BlockLineHeight" />

                <ItemsControl x:Name="SuggestedTags" Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}" Margin="0,0,6,6" Padding="8,2"
                                    FontSize="{DynamicResource Type.Body}"
                                    Cursor="Hand" Click="OnAcceptSuggestedTag"
                                    ToolTip="点击把这个标签加到所选条目" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
        </DockPanel>
    </Border>
</Window>
