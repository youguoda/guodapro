<Window x:Class="Shiyu.App.BarWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Shiyu.App"
        Title="ʰ�� �� խ��" Width="360" Height="620"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual"
        Background="{DynamicResource Brush.Background}"
        FontSize="{DynamicResource Size.Body}"
        PreviewKeyDown="OnPreviewKeyDown"
        MouseLeftButtonDown="OnBackgroundPressed">
    <!--
      The resident narrow bar (ticket 12): summoned by hotkey, pinned to the
      top of the z-order, dragged by its background, resized by the grip.

      Structure follows the issue 02 spike: pinned cards live in their own
      non-virtualized list STACKED above the scrolling region �� visually
      identical to overlaying them, without any scroll synchronization �� and
      the main list virtualizes with recycling so ten thousand entries scroll
      on a handful of containers.
    -->
    <Window.Resources>

        <!-- Rows are plain; the card visuals live in the item template. -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="CardTemplate" DataType="{x:Type local:BarCard}">
            <Border x:Name="Card" CornerRadius="{DynamicResource Radius.Card}"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                    Padding="10,8" MouseLeftButtonDown="OnCardPressed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Meta: where it came from, what it is, when. -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <Grid DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,6,0">
                            <Image Source="{Binding Icon}" Visibility="{Binding IconVisibility}"/>
                            <Border CornerRadius="{DynamicResource Radius.Thumb}"
                                    Background="{DynamicResource Brush.Accent}"
                                    Visibility="{Binding FallbackIconVisibility}">
                                <TextBlock Text="ʰ" FontSize="{DynamicResource Size.Hint}"
                                           Foreground="{DynamicResource Brush.TextOnAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding Meta}" FontSize="{DynamicResource Size.Caption}"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>

                    <!-- Body: text clamped to N lines, images to N units. The
                         text clamp is a height of exact line multiples rather
                         than MaxLines, because this build's XAML compiler
                         rejects bindings on MaxLines. -->
                    <TextBlock x:Name="TextBody" Grid.Row="1" Text="{Binding Preview}"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               MaxHeight="{Binding TextMaxHeight}"
                               LineHeight="{DynamicResource Line.Body}"
                               LineStackingStrategy="BlockLineHeight"
                               Foreground="{DynamicResource Brush.Text}"/>
                    <Border x:Name="ImageBody" Grid.Row="1" MaxHeight="{Binding ImageHeight}"
                            CornerRadius="{DynamicResource Radius.Small}"
                            Background="{DynamicResource Brush.SurfaceSubtle}"
                            Visibility="{Binding ImageVisibility}">
                        <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <!-- Watermarks: quiet, bottom-right, never in the way. -->
                    <TextBlock Grid.Row="1" Text="���ö�" FontSize="{DynamicResource Size.Hint}"
                               Foreground="{DynamicResource Brush.TextTertiary}"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom"
                               Visibility="{Binding PinnedVisibility}"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Image">
                    <Setter TargetName="TextBody" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Text">
                    <Setter TargetName="ImageBody" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.SurfaceSubtle}"/>
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Border x:Name="Header" DockPanel.Dock="Top" Background="{DynamicResource Brush.Surface}"
                Padding="10,8" MouseLeftButtonDown="OnBackgroundPressed">
            <StackPanel>
                <TextBox x:Name="SearchBox" Padding="8,6" TextChanged="OnSearchChanged"
                         VerticalContentAlignment="Center"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <ComboBox x:Name="KindFilter" Width="64" SelectedIndex="0"
                              SelectionChanged="OnFilterChanged">
                        <ComboBoxItem Content="ȫ��" />
                        <ComboBoxItem Content="�ı�" />
                        <ComboBoxItem Content="ͼƬ" />
                    </ComboBox>
                    <ComboBox x:Name="TagFilter" Width="104" Margin="6,0,0,0"
                              SelectionChanged="OnFilterChanged"/>
                    <Button x:Name="ClearFilters" Content="���" Margin="6,0,0,0" Padding="8,2"
                            FontSize="{DynamicResource Size.Caption}" Cursor="Hand"
                            Click="OnClearFilters"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border x:Name="PinnedHost" DockPanel.Dock="Top" Padding="8,6,8,0"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="�ö�" FontSize="{DynamicResource Size.Hint}"
                           Foreground="{DynamicResource Brush.TextTertiary}" Margin="2,0,0,3"/>
                <ItemsControl x:Name="PinnedList" ItemTemplate="{StaticResource CardTemplate}"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.Surface}"
                Padding="10,4" MouseLeftButtonDown="OnBackgroundPressed">
            <Grid>
                <TextBlock x:Name="CountLabel" FontSize="{DynamicResource Size.Hint}"
                           Foreground="{DynamicResource Brush.TextTertiary}"
                           VerticalAlignment="Center"/>
                <Thumb x:Name="SizeGrip" HorizontalAlignment="Right" Width="14" Height="10"
                       Cursor="SizeNS" DragDelta="OnGripDrag" Background="Transparent"/>
            </Grid>
        </Border>

        <ListBox x:Name="Cards" ItemTemplate="{StaticResource CardTemplate}"
                 Background="Transparent" BorderThickness="0"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.ScrollChanged="OnCardsScrolled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 VirtualizingPanel.CacheLength="1"
                 VirtualizingPanel.CacheLengthUnit="Page"/>
    </DockPanel>
</Window>
