<Window x:Class="Shiyu.App.BarWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Shiyu.App"
        Title="拾语 · 窄条" Width="384" Height="620"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Background="Transparent"
        FontSize="{DynamicResource Size.Body}"
        PreviewKeyDown="OnPreviewKeyDown"
        PreviewKeyUp="OnPreviewKeyUp"
        Deactivated="OnLostFocus"
        MouseLeftButtonDown="OnBackgroundPressed">
    <!--
      The resident narrow bar (ticket 12): summoned by hotkey, pinned to the
      top of the z-order, dragged by its background, resized by the grip.

      Structure follows the issue 02 spike: pinned cards live in their own
      non-virtualized list STACKED above the scrolling region - visually
      identical to overlaying them, without any scroll synchronization - and
      the main list virtualizes with recycling so ten thousand entries scroll
      on a handful of containers.

      Key-hint badges (ticket 14) sit inside the visuals they explain: hold
      Ctrl and every actionable icon swaps in place for the key that drives
      it. The badges and the key handler read BarKeys, one source.
    -->
    <Window.Resources>

        <!-- The tray buttons' look; their motion lives in code (ActionTray). -->
        <Style x:Key="TrayButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="{DynamicResource Radius.Thumb}"
                                Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.StateHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The small rounded key badge, wherever it appears. -->
        <Style x:Key="KeyBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Thumb}"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!--
          Kind as underline tabs (the Windows 11 TabView idiom): no boxes to
          collide in a 372px bar — the selected facet reads by a 2px accent
          rule under the label, the rest stay quiet secondary text.
        -->
        <Style x:Key="KindTab" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="FontSize" Value="{DynamicResource Size.Secondary}"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <ContentPresenter x:Name="TabText"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <Border x:Name="Underline" VerticalAlignment="Bottom" Height="2"
                                    CornerRadius="1" Margin="{TemplateBinding Padding}"
                                    Background="Transparent"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Underline" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                                <Setter TargetName="Underline" Property="Background" Value="{DynamicResource Brush.StateHover}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact icon button used by the header (clear / subtype). -->
        <Style x:Key="HeaderIconButton" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="{DynamicResource Radius.Small}"
                                Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.StateHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          The search line (ticket 39): a pill with the magnifier living
          inside it and a placeholder that vanishes with the first
          character. The F key badge overlays the right edge as before.
        -->
        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Chrome" CornerRadius="{DynamicResource Radius.Pill}"
                                Background="{DynamicResource Brush.SurfaceInput}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                            <DockPanel Margin="9,0,28,0">
                                <TextBlock DockPanel.Dock="Left" Text="&#xE721;"
                                           FontFamily="{DynamicResource Font.Icon}"
                                           FontSize="{DynamicResource Size.IconSmall}"
                                           Foreground="{DynamicResource Brush.TextTertiary}"
                                           VerticalAlignment="Center" Margin="0,0,7,0"
                                           IsHitTestVisible="False"/>
                                <Grid VerticalAlignment="Center" Margin="0,6">
                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                                  VerticalAlignment="Center"/>
                                    <TextBlock x:Name="Placeholder" Text="搜索…"
                                               IsHitTestVisible="False" Visibility="Collapsed"
                                               Foreground="{DynamicResource Brush.TextTertiary}"/>
                                </Grid>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          The kind row as four icon chips (ticket 39): SegmentChip
          semantics on an icon face — the checked facet fills with the
          accent and carries TextOnAccent, the rest stay secondary. The
          glyphs match the tray's IconGlyph family so a facet and its
          actions never draw two symbols for one idea.
        -->
        <Style x:Key="KindIconChip" TargetType="ToggleButton">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome" CornerRadius="{DynamicResource Radius.Small}"
                                Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnAccent}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.StateHover}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          The favourite filter (ticket 39): one star that fills when the
          filter is on — E735 is the same glyph the favourite action
          carries, so "make favourite" and "see favourites" agree.
        -->
        <Style x:Key="StarToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="只看收藏"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome" CornerRadius="{DynamicResource Radius.Small}"
                                Background="Transparent">
                            <Grid>
                                <TextBlock x:Name="StarOut" Text="&#xE734;"
                                           FontFamily="{DynamicResource Font.Icon}"
                                           FontSize="{DynamicResource Size.IconSmall}"
                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="StarIn" Text="&#xE735;"
                                           FontFamily="{DynamicResource Font.Icon}"
                                           FontSize="{DynamicResource Size.IconSmall}"
                                           Foreground="{DynamicResource Brush.Accent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="StarOut" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="StarIn" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.StateHover}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The resize grip is a hit area, not a face: the default Thumb
             template paints a raised lump that has nothing to do with the
             sheet it sits on. -->
        <Style x:Key="InvisibleGrip" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rows are plain; the card visuals live in the item template. -->
        <Style TargetType="{x:Type local:BarCardContainer}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type local:BarCardContainer}">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="CardTemplate" DataType="{x:Type local:BarCard}">
            <Border x:Name="Card" CornerRadius="{DynamicResource Radius.Card}"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1.5"
                    Padding="10,8" MouseLeftButtonDown="OnCardPressed"
                    MouseRightButtonUp="OnCardRightClick"
                    MouseEnter="OnCardMouseEnter" MouseLeave="OnCardMouseLeave"
                    MouseMove="OnCardMouseMove">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Meta（票 39 三段式的上行）: where it came from and what
                         it is on the left — the type badge is icon + word, the
                         same glyph family the facet chips use; on the right the
                         timestamp, which yields its place to the hover actions
                         and takes it back afterwards. -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <Grid DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,6,0">
                            <Image Source="{Binding Icon}" Visibility="{Binding IconVisibility}"/>
                            <Border CornerRadius="{DynamicResource Radius.Thumb}"
                                    Background="{DynamicResource Brush.Accent}"
                                    Visibility="{Binding FallbackIconVisibility}">
                                <TextBlock Text="拾" FontSize="{DynamicResource Size.Hint}"
                                           Foreground="{DynamicResource Brush.TextOnAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <!-- Covers the icon exactly while Ctrl is held. -->
                            <local:RowKeyBadge Visibility="Collapsed"/>
                        </Grid>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <local:HandoverText Text="{Binding WhenText}" FontSize="{DynamicResource Size.Caption}"
                                                Foreground="{DynamicResource Brush.TextSecondary}"
                                                VerticalAlignment="Center"
                                                ToolTip="{Binding WhenToolTip}"/>
                            <local:ActionTray Margin="6,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    ToolTip="{Binding KindToolTip}">
                            <TextBlock Text="{Binding KindGlyph}" FontFamily="{DynamicResource Font.Icon}"
                                       FontSize="{DynamicResource Size.IconSmall}"
                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding KindText}" FontSize="{DynamicResource Size.Caption}"
                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Body: text clamped to N lines, images to N units, a
                         colour entry preceded by a swatch of itself. The
                         text clamp is a height of exact line multiples rather
                         than MaxLines, because this build's XAML compiler
                         rejects bindings on MaxLines. -->
                    <DockPanel Grid.Row="1">
                        <Border DockPanel.Dock="Left" Width="44" Height="22" Margin="0,2,8,2"
                                CornerRadius="{DynamicResource Radius.Thumb}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                Background="{Binding SwatchBrush}" Visibility="{Binding SwatchVisibility}"
                                VerticalAlignment="Center"/>
                        <local:EntryBodyText x:Name="TextBody" Text="{Binding Face}"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                   MaxHeight="{Binding TextMaxHeight}"
                                   FontSize="{DynamicResource Size.BodyLarge}"
                                   LineHeight="{DynamicResource Line.BodyLarge}"
                                   LineStackingStrategy="BlockLineHeight"
                                   Foreground="{DynamicResource Brush.Text}"
                                   ToolTip="{Binding DragToolTip}"/>
                        <Border x:Name="ImageBody" Height="{Binding ImageHeight}"
                                ClipToBounds="True"
                                CornerRadius="{DynamicResource Radius.Small}"
                                Background="{DynamicResource Brush.SurfaceSubtle}"
                                Visibility="{Binding ImageVisibility}">
                            <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <!-- Files: type icon per row, dead paths struck through
                             and faded — a path that is gone says so in the
                             list, not after a paste that produced nothing.
                             A copy made only of pictures previews as one. -->
                        <StackPanel x:Name="FilesBody" Visibility="{Binding FilesVisibility}">
                            <Border Height="{Binding ImageHeight}"
                                    ClipToBounds="True"
                                    CornerRadius="{DynamicResource Radius.Small}"
                                    Background="{DynamicResource Brush.SurfaceSubtle}"
                                    Visibility="{Binding FilePreviewVisibility}"
                                    Margin="0,0,0,4">
                                <Image Source="{Binding FilePreviewSource}" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <ItemsControl ItemsSource="{Binding FileRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,1">
                                            <Image Source="{Binding Icon}" Width="16" Height="16"
                                                   Margin="0,0,6,0" VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock x:Name="RowName" Text="{Binding Name}"
                                                       FontSize="{DynamicResource Size.Secondary}"
                                                       Foreground="{DynamicResource Brush.Text}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="RowDead" Text="（路径不存在）"
                                                       FontSize="{DynamicResource Size.Hint}"
                                                       Foreground="{DynamicResource Brush.Danger}"
                                                       Margin="6,0,0,0" VerticalAlignment="Center"
                                                       Visibility="{Binding DeadVisibility}"/>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Dead}" Value="True">
                                                <Setter TargetName="RowName" Property="TextDecorations"
                                                        Value="Strikethrough"/>
                                                <Setter TargetName="RowName" Property="Opacity" Value="0.5"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock FontSize="{DynamicResource Size.Hint}"
                                       Foreground="{DynamicResource Brush.TextTertiary}"
                                       Margin="0,2,0,0" Text="{Binding FileTail}"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Watermarks: quiet, bottom-right, never in the way.
                         The star is a favourite; it never moves the card.
                         The 译 mark says this entry is Shiyu's own kept
                         translation, not something the user copied. The lock
                         is the protected-corner slot (票 39): shown while
                         delete protection covers this card. -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <TextBlock Text="&#xE72E;" FontFamily="{DynamicResource Font.Icon}"
                                   FontSize="{DynamicResource Size.Hint}"
                                   Foreground="{DynamicResource Brush.TextTertiary}"
                                   ToolTip="受删除保护：先取消收藏或置顶，或在设置中调整保护"
                                   Visibility="{Binding ProtectionVisibility}"/>
                        <TextBlock Text="译" FontSize="{DynamicResource Size.Hint}"
                                   Foreground="{DynamicResource Brush.Accent}"
                                   ToolTip="拾语生成的译文，已关联原文条目"
                                   Visibility="{Binding TranslationVisibility}"/>
                        <TextBlock Text="{Binding GroupBadge}" FontSize="{DynamicResource Size.Hint}"
                                   Foreground="{DynamicResource Brush.TextTertiary}"
                                   Margin="4,0,0,0"
                                   Visibility="{Binding GroupBadgeVisibility}"/>
                        <TextBlock Text="★" FontSize="{DynamicResource Size.Hint}"
                                   Foreground="{DynamicResource Brush.Accent}"
                                   Visibility="{Binding FavoriteVisibility}"/>
                        <TextBlock Text="已置顶" FontSize="{DynamicResource Size.Hint}"
                                   Foreground="{DynamicResource Brush.TextTertiary}"
                                   Margin="6,0,0,0"
                                   Visibility="{Binding PinnedVisibility}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Image">
                    <Setter TargetName="TextBody" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="FilesBody" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Text">
                    <Setter TargetName="ImageBody" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="FilesBody" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Files">
                    <Setter TargetName="TextBody" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="ImageBody" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.SurfaceSubtle}"/>
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <!--
      The floating Win11 shell: a translucent brand tint over the DWM Acrylic
      backdrop (ticket 03's recipe — the material renders only on a layered
      window, which this now is), rounded at the Window tier, one soft shadow.
      The header and footer draw nothing themselves so the material reads as
      one continuous sheet behind everything.
    -->
    <Border x:Name="Shell" CornerRadius="{DynamicResource Radius.Window}"
            Background="{DynamicResource Brush.SurfaceMaterial}"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
        <Border.Effect>
            <StaticResource ResourceKey="Shadow.Floating"/>
        </Border.Effect>
    <DockPanel>
        <!--
          Background dragging hangs off the window alone: a bubbling press
          reaches it from anywhere unhandled. Wiring the same handler onto
          these inner borders as well nests DragMove inside DragMove's own
          modal loop, and the outer loop then waits forever for a mouse-up
          the inner one consumed - the whole dispatcher freezes.
        -->
        <Border x:Name="Header" DockPanel.Dock="Top"
                Padding="10,8">
            <StackPanel>
                <!--
                  第一行（票 39）：品牌图标 · 弹性空隙 · 圆角搜索框 · 置顶开关。
                  The brand mark is a palette value (Brand.Mark): light theme
                  carries 拾语, dark carries its dark variant 深语, swapped
                  live with every DynamicResource when the theme changes.
                -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="24" Height="24"
                            CornerRadius="{DynamicResource Radius.Card}" ClipToBounds="True"
                            VerticalAlignment="Center" Margin="0,0,10,0"
                            ToolTip="拾语 · 剪贴板历史窄条">
                        <Image Source="{DynamicResource Brand.Mark}" Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <Grid Grid.Column="1" Margin="0,0,8,0">
                        <TextBox x:Name="SearchBox" Style="{StaticResource SearchBoxStyle}"
                                 TextChanged="OnSearchChanged" VerticalContentAlignment="Center"/>
                        <!-- F: focus search. -->
                        <Border x:Name="SearchKeyBadge" Style="{StaticResource KeyBadge}"
                                HorizontalAlignment="Right" Margin="0,0,8,0" Visibility="Collapsed">
                            <TextBlock Text="F" FontSize="{DynamicResource Size.Hint}"
                                       Foreground="{DynamicResource Brush.TextOnAccent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <!-- 置顶：Topmost 开关。图标随态（E8417 填充/accent =
                         开；E718 常规/次级 = 关），tooltip 写明当前状态。 -->
                    <Button x:Name="TopmostToggle" Grid.Column="2" Width="28" Height="28"
                            Cursor="Hand" Click="OnTopmostToggle"
                            Style="{StaticResource HeaderIconButton}">
                        <TextBlock x:Name="TopmostGlyph" Text="&#xE718;"
                                   FontFamily="{DynamicResource Font.Icon}"
                                   FontSize="{DynamicResource Size.IconMedium}"/>
                    </Button>
                </Grid>
                <!--
                  第二行（票 39）：一行图标工具栏，四组之间细分隔线——
                  类型筛选（互斥图标，←→ 循环）· 收藏 · 分组管理（E712 弹
                  菜单）· 子类型/标签筛选（低频，收在漏斗与标签组合里）。
                  The tag combo stays for the Tab cycle: a filter the keyboard
                  still drives has to stay on the face.
                -->
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" x:Name="KindChips">
                        <ToggleButton x:Name="KindChipAll" Tag="0"
                                      Style="{StaticResource KindIconChip}"
                                      Cursor="Hand" Click="OnKindChipClicked"
                                      ToolTip="全部（←→ 切换类型）">
                            <TextBlock Text="&#xE8A9;" FontFamily="{DynamicResource Font.Icon}"
                                       FontSize="{DynamicResource Size.IconSmall}"/>
                        </ToggleButton>
                        <ToggleButton x:Name="KindChipText" Tag="1"
                                      Style="{StaticResource KindIconChip}"
                                      Cursor="Hand" Click="OnKindChipClicked"
                                      ToolTip="只看文本">
                            <TextBlock Text="&#xE8D2;" FontFamily="{DynamicResource Font.Icon}"
                                       FontSize="{DynamicResource Size.IconSmall}"/>
                        </ToggleButton>
                        <ToggleButton x:Name="KindChipImage" Tag="2"
                                      Style="{StaticResource KindIconChip}"
                                      Cursor="Hand" Click="OnKindChipClicked"
                                      ToolTip="只看图片">
                            <TextBlock Text="&#xE8B9;" FontFamily="{DynamicResource Font.Icon}"
                                       FontSize="{DynamicResource Size.IconSmall}"/>
                        </ToggleButton>
                        <ToggleButton x:Name="KindChipFiles" Tag="3"
                                      Style="{StaticResource KindIconChip}"
                                      Cursor="Hand" Click="OnKindChipClicked"
                                      ToolTip="只看文件">
                            <TextBlock Text="&#xE8B7;" FontFamily="{DynamicResource Font.Icon}"
                                       FontSize="{DynamicResource Size.IconSmall}"/>
                        </ToggleButton>
                        <!-- ←→: cycle the kind facet. -->
                        <Border x:Name="KindKeyBadge" Style="{StaticResource KeyBadge}"
                                Margin="4,0,0,0" Visibility="Collapsed">
                            <TextBlock Text="←→" FontSize="{DynamicResource Size.Hint}"
                                       Foreground="{DynamicResource Brush.TextOnAccent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                    <Border Width="1" Margin="6,4" Background="{DynamicResource Brush.Border}"/>
                    <ToggleButton x:Name="FavoriteOnly" Style="{StaticResource StarToggleStyle}"
                                  Checked="OnFilterChanged" Unchecked="OnFilterChanged"/>
                    <Border Width="1" Margin="6,4" Background="{DynamicResource Brush.Border}"/>
                    <Button x:Name="GroupMenuButton" Width="26" Height="24"
                            Style="{StaticResource HeaderIconButton}" Click="OnGroupMenuClicked"
                            ToolTip="分组：切换抽屉、删除分组、新建分组（头部管分组本身，卡片管卡片的归属）">
                        <TextBlock Text="&#xE712;" FontFamily="{DynamicResource Font.Icon}"
                                   FontSize="{DynamicResource Size.IconSmall}"/>
                    </Button>
                    <Border Width="1" Margin="6,4" Background="{DynamicResource Brush.Border}"/>
                    <Grid Margin="2,0,0,0">
                        <ComboBox x:Name="TagFilter" Width="80"
                                  SelectionChanged="OnFilterChanged"/>
                        <!-- Tab: cycle the tag filter. -->
                        <Border x:Name="TagKeyBadge" Style="{StaticResource KeyBadge}"
                                HorizontalAlignment="Right" Margin="0,0,6,0" Width="24"
                                Visibility="Collapsed">
                            <TextBlock Text="Tab" FontSize="{DynamicResource Size.Hint}"
                                       Foreground="{DynamicResource Brush.TextOnAccent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <Button x:Name="SubtypeButton" Width="26" Height="24" Margin="4,0,0,0"
                            Style="{StaticResource HeaderIconButton}" Click="OnSubtypeButtonClicked"
                            ToolTip="按子类型筛选：链接 / 邮箱 / 颜色 / 路径">
                        <TextBlock Text="&#xE71C;" FontFamily="{DynamicResource Font.Icon}"
                                   FontSize="{DynamicResource Size.IconSmall}"/>
                    </Button>
                    <Button x:Name="ClearFilters" Width="26" Height="24" Margin="2,0,0,0"
                            Style="{StaticResource HeaderIconButton}" Click="OnClearFilters"
                            ToolTip="清除全部筛选">
                        <TextBlock Text="&#xE711;" FontFamily="{DynamicResource Font.Icon}"
                                   FontSize="{DynamicResource Size.IconSmall}"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!--
          Groups switch, tags filter: the tabs below are drawers (picking one
          shows only its pile), the tag combo above is a label that stacks on
          top of whatever else is asked.
        -->
        <Border x:Name="GroupHostBorder" DockPanel.Dock="Top" Padding="10,0,10,6"
                Visibility="Collapsed">
            <ScrollViewer x:Name="GroupHost" HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled"
                          SizeChanged="OnGroupHostResized">
                <StackPanel x:Name="GroupRow" Orientation="Horizontal">
                    <ToggleButton x:Name="AllGroupChip" Content="全部" Padding="7,0" Margin="0,0,2,0"
                                  Style="{StaticResource KindTab}"
                                  Click="OnGroupChipClicked" ToolTip="不看特定分组"/>
                    <ToggleButton x:Name="GroupOverflow" Content="⋯" Width="26"
                                  Style="{StaticResource KindTab}"
                                  Click="OnGroupOverflowClicked" ToolTip="收起的分组"
                                  Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border x:Name="PinnedHost" DockPanel.Dock="Top" Padding="8,6,8,0"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="置顶" FontSize="{DynamicResource Size.Hint}"
                           Foreground="{DynamicResource Brush.TextTertiary}" Margin="2,0,0,3"/>
                <!--
                  The same container type as the main list: pinned cards need
                  hover trays too, and an ItemsControl's bare presenters never
                  run the tray configuration.
                -->
                <local:BarCardsList x:Name="PinnedList" ItemTemplate="{StaticResource CardTemplate}"
                                    Background="Transparent" BorderThickness="0"
                                    HorizontalContentAlignment="Stretch"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="10,4">
            <Grid>
                <TextBlock x:Name="CountLabel" FontSize="{DynamicResource Size.Hint}"
                           Foreground="{DynamicResource Brush.TextTertiary}"
                           VerticalAlignment="Center"/>
                <DockPanel x:Name="FeedbackHost" LastChildFill="False"
                           VerticalAlignment="Center" Visibility="Collapsed">
                    <Button x:Name="UndoButton" DockPanel.Dock="Right" Content="撤销"
                            Padding="8,1" FontSize="{DynamicResource Size.Caption}"
                            Cursor="Hand" Click="OnUndoDelete"
                            Margin="0,0,24,0"
                            Visibility="Collapsed"
                            ToolTip="恢复刚删除的条目（Ctrl+Z）"/>
                    <TextBlock x:Name="FeedbackLabel" VerticalAlignment="Center"
                               FontSize="{DynamicResource Size.Hint}"
                               Foreground="{DynamicResource Brush.TextSecondary}"/>
                </DockPanel>
                <Thumb x:Name="SizeGrip" HorizontalAlignment="Right" Width="22" Height="14"
                       Cursor="SizeNS" DragDelta="OnGripDrag" Background="Transparent"
                       Style="{StaticResource InvisibleGrip}"/>
            </Grid>
        </Border>

        <!--
          The empty state explains WHY the list is empty — the filter that
          ate everything, or a history that is yet to begin — because "no
          results" reads as breakage exactly when the user needs help most.
        -->
        <Grid>
            <local:BarCardsList x:Name="Cards" ItemTemplate="{StaticResource CardTemplate}"
                                Background="Transparent" BorderThickness="0"
                                HorizontalContentAlignment="Stretch"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                ScrollViewer.ScrollChanged="OnCardsScrolled"
                                VirtualizingPanel.IsVirtualizing="True"
                                VirtualizingPanel.VirtualizationMode="Recycling"
                                VirtualizingPanel.ScrollUnit="Pixel"
                                VirtualizingPanel.CacheLength="1"
                                VirtualizingPanel.CacheLengthUnit="Page"/>

            <Border x:Name="EmptyHost" Visibility="Collapsed"
                    Background="{DynamicResource Brush.Surface}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MaxWidth="300" Margin="16,0">
                <StackPanel>
                    <TextBlock x:Name="EmptyHeadline" TextWrapping="Wrap" TextAlignment="Center"
                               FontSize="{DynamicResource Size.BodyLarge}"
                               Foreground="{DynamicResource Brush.Text}"/>
                    <TextBlock x:Name="EmptyHint" TextWrapping="Wrap" TextAlignment="Center"
                               Margin="0,6,0,0"
                               FontSize="{DynamicResource Size.Caption}"
                               Foreground="{DynamicResource Brush.TextTertiary}"/>
                    <Button x:Name="EmptyClear" Content="清除筛选" Margin="0,10,0,0"
                            Padding="14,5,14,5" HorizontalAlignment="Center"
                            Cursor="Hand" Click="OnClearFilters"
                            Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
    </Border>
</Window>
