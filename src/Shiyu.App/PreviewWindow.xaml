<Window x:Class="Shiyu.App.PreviewWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="拾语 · 预览" Width="360" Height="240"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        Focusable="False"
        AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="Manual"
        FontSize="{DynamicResource Type.Body}"
        TextElement.FontFamily="{DynamicResource Font.Ui}"
        TextElement.Foreground="{DynamicResource Brush.Text}"
        MouseEnter="OnMouseEnter" MouseLeave="OnMouseLeave">
    <!--
      The full-content preview (ticket 17). Round, translucent over the theme's
      own surface colour (set in code so theme switches reach it), blurred by
      the system material (DwmEffects, on the handle), and never activated:
      reading it costs the user nothing, not even their caret.

      The size is decided before anything is shown, from numbers the database
      already has, so the window opens at the size it keeps. Content that
      outgrows the box scrolls; the box never moves.
    -->
    <!--
      外壳（§4.7，票 20）：只画 SurfaceMaterial 材质底；圆角 8、轮廓与
      投影归 DWM（DwmEffects 在句柄上设，拒收时 OnSourceInitialized 落
      Backdrop.DegradeShell 的自绘描边+阴影与 12 DIP 透明边距）。
      同色桥（§3.3 P2）：与卡片对齐时的连接表达——面向窄条那条边上一
      条 2 DIP accent 边线，由窄条按对齐条件决定显隐，不画曲线。
    -->
    <Border x:Name="Root" CornerRadius="{DynamicResource Radius.Overlay}"
            Background="{DynamicResource Brush.SurfaceMaterial}"
            BorderThickness="0"
            Padding="12,10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="BridgeLeft" Grid.RowSpan="2" Width="2" Margin="0,8"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource Brush.Accent}" Visibility="Collapsed"/>
            <Border x:Name="BridgeRight" Grid.RowSpan="2" Width="2" Margin="0,8"
                    HorizontalAlignment="Right"
                    Background="{DynamicResource Brush.Accent}" Visibility="Collapsed"/>

            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                <TextBlock x:Name="WhenText" DockPanel.Dock="Right"
                           FontSize="{DynamicResource Type.Caption}"
                           Foreground="{DynamicResource Brush.TextTertiary}"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                <TextBlock x:Name="KindText" FontSize="{DynamicResource Type.Caption}"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>

            <Grid Grid.Row="1">
                <ScrollViewer x:Name="TextHost" Focusable="False"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <!-- 预览正文：被阅读的内容，Type.Content 18/31（ADR-0012 排版 2）；
                         Measure() 用同一对常量算尺寸。 -->
                    <TextBlock x:Name="TextBody" TextWrapping="Wrap"
                               FontSize="{DynamicResource Type.Content}"
                               LineHeight="{DynamicResource Line.Content}"
                               LineStackingStrategy="BlockLineHeight"
                               Foreground="{DynamicResource Brush.Text}"/>
                </ScrollViewer>

                <Image x:Name="ImageHost" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <ScrollViewer x:Name="FilesHost" Focusable="False"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <StackPanel x:Name="FilesBody"/>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
