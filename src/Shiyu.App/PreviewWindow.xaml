<Window x:Class="Shiyu.App.PreviewWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="拾语 · 预览" Width="360" Height="240"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        Focusable="False"
        AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="Manual"
        FontSize="{DynamicResource Size.Body}"
        TextElement.FontFamily="{DynamicResource Font.Ui}"
        TextElement.Foreground="{DynamicResource Brush.Text}"
        MouseEnter="OnMouseEnter" MouseLeave="OnMouseLeave">
    <!--
      The full-content preview (ticket 17). Round, translucent over the theme's
      own surface colour (set in code so theme switches reach it), blurred by
      the system material (DwmEffects, on the handle), and never activated:
      reading it costs the user nothing, not even their caret.

      The size is decided before anything is shown, from numbers the database
      already has, so the window opens at the size it keeps. Content that
      outgrows the box scrolls; the box never moves.
    -->
    <Border x:Name="Root" CornerRadius="12"
            Background="#F2FFFFFF" BorderBrush="#99D0D7DE" BorderThickness="1"
            Padding="12,10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.25"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                <TextBlock x:Name="WhenText" DockPanel.Dock="Right"
                           FontSize="{DynamicResource Size.Caption}"
                           Foreground="{DynamicResource Brush.TextTertiary}"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                <TextBlock x:Name="KindText" FontSize="{DynamicResource Size.Caption}"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>

            <Grid Grid.Row="1">
                <ScrollViewer x:Name="TextHost" Focusable="False"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="TextBody" TextWrapping="Wrap"
                               LineHeight="{DynamicResource Line.Body}"
                               LineStackingStrategy="BlockLineHeight"
                               Foreground="{DynamicResource Brush.Text}"/>
                </ScrollViewer>

                <Image x:Name="ImageHost" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <ScrollViewer x:Name="FilesHost" Focusable="False"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <StackPanel x:Name="FilesBody"/>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
