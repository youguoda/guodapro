<Window x:Class="Shiyu.App.QuickBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        SizeToContent="Height" Width="460"
        TextElement.FontFamily="{DynamicResource Font.Ui}"
        TextElement.FontSize="{DynamicResource Type.Body}"
        TextElement.Foreground="{DynamicResource Brush.Text}"
        Deactivated="OnDeactivated" PreviewKeyDown="OnPreviewKeyDown">
    <Border x:Name="Shell" CornerRadius="{DynamicResource Radius.Window}" Background="{DynamicResource Brush.SurfaceMaterial}"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
        <Border.Effect>
            <StaticResource ResourceKey="Shadow.Floating"/>
        </Border.Effect>

        <StackPanel Margin="10,8">
            <TextBox x:Name="FilterBox" FontSize="{DynamicResource Type.Body}" Padding="8,6"
                     BorderThickness="0" TextChanged="OnFilterChanged" />

            <ListBox x:Name="Items" Margin="0,8,0,0" MaxHeight="260" BorderThickness="0"
                     Background="Transparent" HorizontalContentAlignment="Stretch"
                     VirtualizingPanel.IsVirtualizing="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="OnItemActivated">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,4">
                            <TextBlock Text="{Binding Preview}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Meta}" FontSize="{DynamicResource Type.Caption}"
                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="EmptyLabel" Text="没有匹配的记录" Margin="4,10,0,4"
                       Foreground="{DynamicResource Brush.TextTertiary}"
                       FontSize="{DynamicResource Type.Body}" Visibility="Collapsed" />

            <TextBlock Margin="4,8,0,2" FontSize="{DynamicResource Type.Caption}"
                       Foreground="{DynamicResource Brush.TextTertiary}"
                       Text="↑↓ 选择 · Enter 粘贴 · Esc 关闭" />
        </StackPanel>
    </Border>
</Window>
