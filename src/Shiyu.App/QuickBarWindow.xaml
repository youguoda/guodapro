<Window x:Class="Shiyu.App.QuickBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        SizeToContent="Height" Width="460"
        Deactivated="OnDeactivated" PreviewKeyDown="OnPreviewKeyDown">
    <Border CornerRadius="9" Background="#FCFFFFFF" BorderBrush="#26000000" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.28" />
        </Border.Effect>

        <StackPanel Margin="9,8">
            <TextBox x:Name="FilterBox" FontSize="13" Padding="7,5" BorderThickness="0"
                     Background="#12000000" TextChanged="OnFilterChanged" />

            <ListBox x:Name="Items" Margin="0,7,0,0" MaxHeight="260" BorderThickness="0"
                     Background="Transparent" HorizontalContentAlignment="Stretch"
                     VirtualizingPanel.IsVirtualizing="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="OnItemActivated">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,3">
                            <TextBlock Text="{Binding Preview}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Meta}" FontSize="10" Opacity="0.5" Margin="0,2,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="EmptyLabel" Text="没有匹配的记录" Margin="4,9,0,3"
                       Opacity="0.45" FontSize="12" Visibility="Collapsed" />

            <TextBlock Margin="4,7,0,1" FontSize="10" Opacity="0.4"
                       Text="↑↓ 选择 · Enter 粘贴 · Esc 关闭" />
        </StackPanel>
    </Border>
</Window>
