<Window x:Class="Shiyu.App.BadgeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowActivated="False" ShowInTaskbar="False" Topmost="True"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        Focusable="False" Opacity="0">
    <Border x:Name="Pill" CornerRadius="{DynamicResource Radius.Pill}" Padding="12,6" Cursor="Hand"
            Background="{DynamicResource Brush.AccentFloating}" MouseLeftButtonUp="OnClicked">
        <Border.Effect>
            <StaticResource ResourceKey="Shadow.Badge"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="译" Foreground="{DynamicResource Brush.TextOnAccent}"
                       FontSize="{DynamicResource Size.Body}"
                       FontWeight="{DynamicResource Weight.Emphasis}" />
            <TextBlock Text="翻译这段" Foreground="{DynamicResource Brush.TextOnAccent}"
                       FontSize="{DynamicResource Size.Secondary}" Margin="8,0,0,0"
                       VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</Window>
