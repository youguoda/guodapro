<Window x:Class="Shiyu.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="拾语 · 设置" Height="600" Width="560"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        FontSize="13">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="SectionHeading">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,7" />
        </Style>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="Width" Value="104" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="18,14,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="快捷键" Style="{StaticResource SectionHeading}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="划词翻译" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="CaptureHotkey" Width="190" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="翻译剪贴板" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="ClipboardHotkey" Width="190" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="快速条" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="QuickBarHotkey" Width="190" />
                </StackPanel>
                <TextBlock Text="形如 Ctrl+Shift+Z。改动在保存后立即生效；被别的软件占用时会提示。"
                           FontSize="11" Opacity="0.5" Margin="104,6,0,0" TextWrapping="Wrap" />

                <TextBlock Text="语言" Style="{StaticResource SectionHeading}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="译文语言" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="TargetLanguage" Width="190" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="原文语言" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="SourceLanguage" Width="190" />
                </StackPanel>
                <TextBlock Text="原文语言留空表示由后端自行判断。" FontSize="11" Opacity="0.5"
                           Margin="104,6,0,0" />

                <TextBlock Text="翻译后端" Style="{StaticResource SectionHeading}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="接口地址" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="BackendUrl" Width="340" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="模型" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="BackendModel" Width="340" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="凭据" Style="{StaticResource FieldLabel}" />
                    <PasswordBox x:Name="BackendKey" Width="340" Padding="6,4"
                                 VerticalContentAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="KeyHint" FontSize="11" Opacity="0.5" Margin="104,6,0,0" />

                <TextBlock Text="数据" Style="{StaticResource SectionHeading}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="图片保留" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="RetentionDays" Width="70" />
                    <TextBlock Text="天后清理原图（文本永不清理）" VerticalAlignment="Center"
                               Opacity="0.55" FontSize="12" Margin="8,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="数据位置" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="DataDirectory" Width="268" TextChanged="OnDataDirectoryChanged" />
                    <Button Content="浏览…" Padding="9,3" Margin="6,0,0,0" Click="OnBrowseDataDirectory" />
                </StackPanel>
                <TextBlock x:Name="SyncWarning" FontSize="11" Foreground="#C0392B" TextWrapping="Wrap"
                           Margin="104,6,0,0" Visibility="Collapsed" />
                <TextBlock Text="留空表示使用默认位置。更改后需要重启拾语。" FontSize="11" Opacity="0.5"
                           Margin="104,4,0,0" />

                <TextBlock Text="排除规则" Style="{StaticResource SectionHeading}" />
                <TextBlock Text="这些来源或内容永远不会进入历史。每行一条；以 re: 开头表示正则匹配内容。"
                           FontSize="11" Opacity="0.55" TextWrapping="Wrap" Margin="0,0,0,6" />
                <TextBox x:Name="ExclusionRules" Height="96" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
                <TextBlock x:Name="PresetNote" FontSize="11" Opacity="0.5" Margin="0,6,0,0"
                           TextWrapping="Wrap" />

                <TextBlock Text="启动" Style="{StaticResource SectionHeading}" />
                <CheckBox x:Name="StartWithWindows" Content="开机时自动启动拾语"
                          VerticalContentAlignment="Center" />
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="1" LastChildFill="False" Margin="0,14,0,0">
            <TextBlock x:Name="SaveStatus" DockPanel.Dock="Left" VerticalAlignment="Center"
                       Opacity="0.65" FontSize="12" TextWrapping="Wrap" MaxWidth="330" />
            <Button DockPanel.Dock="Right" Content="保存" MinWidth="86" Padding="12,5"
                    Click="OnSave" />
            <Button DockPanel.Dock="Right" Content="关闭" MinWidth="86" Padding="12,5"
                    Margin="0,0,8,0" Click="OnClose" />
        </DockPanel>
    </Grid>
</Window>
