<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Shiyu.Core\Shiyu.Core.csproj" />
    <ProjectReference Include="..\Shiyu.Windows\Shiyu.Windows.csproj" />
  </ItemGroup>

  <!-- The brand marks ride as loose resources so ThemeManager can address
       them by pack URI and swap them with the palette (ticket 39). -->
  <ItemGroup>
    <Resource Include="Assets\*.png" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The about page's 拾 mark as the exe/window/taskbar icon (user
         request 2026-10-04). Nine PNG-in-ICO frames, 16..256. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
