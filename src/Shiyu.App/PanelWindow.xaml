<Window x:Class="Shiyu.App.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowActivated="False" ShowInTaskbar="False" Topmost="True"
        ResizeMode="NoResize" SizeToContent="Height" Width="420" Opacity="0"
        TextElement.FontFamily="{DynamicResource Font.Ui}"
        TextElement.FontSize="{DynamicResource Type.Body}"
        TextElement.Foreground="{DynamicResource Brush.Text}">
    <!-- 外壳（§4.7，票 20）：只画材质底；圆角 8、轮廓与投影归 DWM
         （Overlay 8 与 DWM 同心，ADR-0012 §5）。DWM 拒收时由
         Backdrop.AttachShell 落自绘描边+阴影与 12 DIP 透明边距。 -->
    <Border x:Name="Shell" CornerRadius="{DynamicResource Radius.Overlay}" Background="{DynamicResource Brush.SurfaceMaterial}"
            BorderThickness="0">

        <StackPanel Margin="14,12">
            <DockPanel LastChildFill="False" Margin="0,0,0,8">
                <TextBlock x:Name="DirectionLabel" DockPanel.Dock="Left"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           FontSize="{DynamicResource Type.Caption}" VerticalAlignment="Center" />
                <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="✕"
                        FontSize="{DynamicResource Type.Caption}" Padding="6,2" BorderThickness="0"
                        Background="Transparent" Cursor="Hand" Click="OnClose" ToolTip="关闭（Esc）" />
                <Button x:Name="SwapButton" DockPanel.Dock="Right" Content="⇄ 换方向"
                        FontSize="{DynamicResource Type.Body}" Padding="8,2" Margin="0,0,6,0"
                        BorderThickness="0" Background="Transparent" Cursor="Hand"
                        Click="OnSwapDirection" />
                <Button x:Name="SentenceToggle" DockPanel.Dock="Right" Content="逐句对照"
                        FontSize="{DynamicResource Type.Body}" Padding="8,2" Margin="0,0,6,0"
                        BorderThickness="0" Background="Transparent" Cursor="Hand"
                        Click="OnToggleSentenceAlignment" ToolTip="按句对照显示原文与译文（默认整段）" />
            </DockPanel>

            <!-- 原文是译文的"出处"而非第一视觉位：比译文低一档（14/24，次级色），
                 层级方向与 UI 报告 §6.2"原文小于译文"一致。 -->
            <TextBlock x:Name="OriginalText" FontSize="{DynamicResource Type.Body}"
                       LineHeight="{DynamicResource Line.BodyMulti}"
                       LineStackingStrategy="BlockLineHeight"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       TextWrapping="Wrap" MaxHeight="72" />

            <Separator Margin="0,8" />

            <ScrollViewer x:Name="TranslationScroll" MaxHeight="260"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock x:Name="TranslatedText" FontSize="{DynamicResource Type.Content}"
                               TextWrapping="Wrap" LineHeight="{DynamicResource Line.Content}"
                               LineStackingStrategy="BlockLineHeight" />
                    <ItemsControl x:Name="SentencePairs" Visibility="Collapsed" Margin="0,2,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,6,0,0">
                                    <TextBlock Text="{Binding Original}" TextWrapping="Wrap"
                                               FontSize="{DynamicResource Type.Body}"
                                               LineHeight="{DynamicResource Line.BodyMulti}"
                                               LineStackingStrategy="BlockLineHeight"
                                               Foreground="{DynamicResource Brush.TextSecondary}" />
                                    <TextBlock Text="{Binding Translated}" TextWrapping="Wrap"
                                               FontSize="{DynamicResource Type.Content}"
                                               LineHeight="{DynamicResource Line.Content}"
                                               LineStackingStrategy="BlockLineHeight" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- 两阶段词典卡：翻译先出，这张卡晚一点补上；没有就从来不出现。 -->
            <Border x:Name="DictionaryArea" Visibility="Collapsed" Margin="0,10,0,0"
                    Padding="10,8" CornerRadius="{DynamicResource Radius.Card}"
                    Background="{DynamicResource Brush.SurfaceSubtle}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <!-- 词头 20 SemiBold（拉丁）专用档，UI 报告 §6.2 单词态。 -->
                        <TextBlock x:Name="CardWord" FontSize="{DynamicResource Type.Headword}"
                                   FontWeight="{DynamicResource Weight.Emphasis}" />
                        <TextBlock x:Name="CardPhonetic" Margin="8,0,0,0" VerticalAlignment="Center"
                                   FontSize="{DynamicResource Type.Body}" FontStyle="Italic"
                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                    </StackPanel>
                    <ItemsControl x:Name="CardSenses" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4,0,0">
                                    <TextBlock Text="{Binding PartOfSpeech}"
                                               FontSize="{DynamicResource Type.Caption}"
                                               Foreground="{DynamicResource Brush.Accent}" />
                                    <ItemsControl ItemsSource="{Binding Definitions}" Margin="8,2,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                                           FontSize="{DynamicResource Type.Body}"
                                                           Margin="0,1" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding Examples}" Margin="8,2,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- 例句/同义词走次级色：三级色在卡面上只有 4.33:1（票 18） -->
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                                           FontSize="{DynamicResource Type.Caption}"
                                                           FontStyle="Italic" Margin="0,1"
                                                           Foreground="{DynamicResource Brush.TextSecondary}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding SynonymsLine}" TextWrapping="Wrap"
                                               FontSize="{DynamicResource Type.Caption}" Margin="8,2,0,0"
                                               Foreground="{DynamicResource Brush.TextSecondary}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 未配置翻译服务时的引导卡（票 08）：给一条去路，不给一段异常。 -->
            <Border x:Name="SetupCard" Visibility="Collapsed" Margin="0,10,0,0"
                    Padding="12,10" CornerRadius="{DynamicResource Radius.Card}"
                    Background="{DynamicResource Brush.SurfaceSubtle}"
                    BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="还没有配置翻译服务" FontSize="{DynamicResource Type.Body}"
                               FontWeight="{DynamicResource Weight.Emphasis}" />
                    <TextBlock Text="翻译需要一个你自己的 API 密钥：设置 → 服务里选一家服务商预设（有免费的），点「申请密钥」，粘进来即可。"
                               TextWrapping="Wrap" Margin="0,4,0,0"
                               FontSize="{DynamicResource Type.Caption}"
                               LineHeight="{DynamicResource Line.CaptionMulti}"
                               LineStackingStrategy="BlockLineHeight"
                               Foreground="{DynamicResource Brush.TextSecondary}" />
                    <Button x:Name="SetupButton" Content="去配置" HorizontalAlignment="Left"
                            Margin="0,8,0,0" Padding="14,4" Cursor="Hand" Click="OnOpenSetup"
                            ToolTip="打开设置的服务页"/>
                    <TextBlock Text="用公共通道？暂未开放" Margin="0,8,0,0"
                               FontSize="{DynamicResource Type.Caption}"
                               Foreground="{DynamicResource Brush.TextTertiary}"
                               ToolTip="公共通道将在上线条件满足后开放：自定义域名大陆实测可达、服务端加固完成、运营费用有人承担。"/>
                </StackPanel>
            </Border>

            <!-- 错误反馈 12/20 Danger（UI 报告 §6.3 校验规格同族）。 -->
            <TextBlock x:Name="StatusText" FontSize="{DynamicResource Type.Caption}"
                       LineHeight="{DynamicResource Line.CaptionMulti}"
                       LineStackingStrategy="BlockLineHeight"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap" Foreground="{DynamicResource Brush.Danger}"
                       Visibility="Collapsed" />

            <DockPanel LastChildFill="False" Margin="0,10,0,0">
                <TextBlock x:Name="HintText" DockPanel.Dock="Left"
                           FontSize="{DynamicResource Type.Caption}"
                           Foreground="{DynamicResource Brush.TextTertiary}"
                           Text="Esc 关闭" VerticalAlignment="Center" />
                <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="存入历史" IsEnabled="False"
                        FontSize="{DynamicResource Type.Body}" Padding="10,4" Margin="0,0,6,0"
                        Cursor="Hand" Click="OnSaveToHistory"
                        ToolTip="译文存为一条记录，并关联原文条目"/>
                <Button x:Name="SpeakButton" DockPanel.Dock="Right" Content="🔊 朗读"
                        FontSize="{DynamicResource Type.Body}" Padding="10,4" Margin="0,0,6,0"
                        Cursor="Hand" Click="OnSpeak"
                        ToolTip="朗读译文；朗读中再点一次即停"/>
                <Button x:Name="CopyButton" DockPanel.Dock="Right" Content="复制译文"
                        FontSize="{DynamicResource Type.Body}" Padding="10,4" Cursor="Hand"
                        Click="OnCopy" />
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
