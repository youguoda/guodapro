<Window x:Class="Shiyu.App.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowActivated="False" ShowInTaskbar="False" Topmost="True"
        ResizeMode="NoResize" SizeToContent="Height" Width="420" Opacity="0"
        TextElement.FontFamily="{DynamicResource Font.Ui}"
        TextElement.FontSize="{DynamicResource Size.Body}"
        TextElement.Foreground="{DynamicResource Brush.Text}">
    <Border x:Name="Shell" CornerRadius="{DynamicResource Radius.Window}" Background="{DynamicResource Brush.SurfaceMaterial}"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
        <Border.Effect>
            <StaticResource ResourceKey="Shadow.Floating"/>
        </Border.Effect>

        <StackPanel Margin="14,12">
            <DockPanel LastChildFill="False" Margin="0,0,0,8">
                <TextBlock x:Name="DirectionLabel" DockPanel.Dock="Left"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           FontSize="{DynamicResource Size.Caption}" VerticalAlignment="Center" />
                <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="✕"
                        FontSize="{DynamicResource Size.Caption}" Padding="6,2" BorderThickness="0"
                        Background="Transparent" Cursor="Hand" Click="OnClose" ToolTip="关闭（Esc）" />
                <Button x:Name="SwapButton" DockPanel.Dock="Right" Content="⇄ 换方向"
                        FontSize="{DynamicResource Size.Caption}" Padding="8,2" Margin="0,0,6,0"
                        BorderThickness="0" Background="Transparent" Cursor="Hand"
                        Click="OnSwapDirection" />
                <Button x:Name="SentenceToggle" DockPanel.Dock="Right" Content="逐句对照"
                        FontSize="{DynamicResource Size.Caption}" Padding="8,2" Margin="0,0,6,0"
                        BorderThickness="0" Background="Transparent" Cursor="Hand"
                        Click="OnToggleSentenceAlignment" ToolTip="按句对照显示原文与译文（默认整段）" />
            </DockPanel>

            <TextBlock x:Name="OriginalText" FontSize="{DynamicResource Size.Secondary}"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       TextWrapping="Wrap" MaxHeight="72" />

            <Separator Margin="0,8" />

            <ScrollViewer x:Name="TranslationScroll" MaxHeight="260"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock x:Name="TranslatedText" FontSize="{DynamicResource Size.BodyLarge}"
                               TextWrapping="Wrap" LineHeight="{DynamicResource Line.BodyLarge}"
                               LineStackingStrategy="BlockLineHeight" />
                    <ItemsControl x:Name="SentencePairs" Visibility="Collapsed" Margin="0,2,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,6,0,0">
                                    <TextBlock Text="{Binding Original}" TextWrapping="Wrap"
                                               FontSize="{DynamicResource Size.Secondary}"
                                               Foreground="{DynamicResource Brush.TextSecondary}" />
                                    <TextBlock Text="{Binding Translated}" TextWrapping="Wrap"
                                               FontSize="{DynamicResource Size.BodyLarge}"
                                               LineHeight="{DynamicResource Line.BodyLarge}"
                                               LineStackingStrategy="BlockLineHeight" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- 两阶段词典卡：翻译先出，这张卡晚一点补上；没有就从来不出现。 -->
            <Border x:Name="DictionaryArea" Visibility="Collapsed" Margin="0,10,0,0"
                    Padding="10,8" CornerRadius="{DynamicResource Radius.Card}"
                    Background="{DynamicResource Brush.SurfaceSubtle}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="CardWord" FontSize="{DynamicResource Size.Body}"
                                   FontWeight="{DynamicResource Weight.Emphasis}" />
                        <TextBlock x:Name="CardPhonetic" Margin="8,0,0,0" VerticalAlignment="Center"
                                   FontSize="{DynamicResource Size.Caption}" FontStyle="Italic"
                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                    </StackPanel>
                    <ItemsControl x:Name="CardSenses" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4,0,0">
                                    <TextBlock Text="{Binding PartOfSpeech}"
                                               FontSize="{DynamicResource Size.Caption}"
                                               Foreground="{DynamicResource Brush.Accent}" />
                                    <ItemsControl ItemsSource="{Binding Definitions}" Margin="8,2,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                                           FontSize="{DynamicResource Size.Caption}"
                                                           Margin="0,1" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding Examples}" Margin="8,2,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- 例句/同义词走次级色：三级色在卡面上只有 4.33:1（票 18） -->
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                                           FontSize="{DynamicResource Size.Hint}"
                                                           FontStyle="Italic" Margin="0,1"
                                                           Foreground="{DynamicResource Brush.TextSecondary}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding SynonymsLine}" TextWrapping="Wrap"
                                               FontSize="{DynamicResource Size.Hint}" Margin="8,2,0,0"
                                               Foreground="{DynamicResource Brush.TextSecondary}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusText" FontSize="{DynamicResource Size.Caption}" Margin="0,8,0,0"
                       TextWrapping="Wrap" Foreground="{DynamicResource Brush.Danger}"
                       Visibility="Collapsed" />

            <DockPanel LastChildFill="False" Margin="0,10,0,0">
                <TextBlock x:Name="HintText" DockPanel.Dock="Left"
                           FontSize="{DynamicResource Size.Hint}"
                           Foreground="{DynamicResource Brush.TextTertiary}"
                           Text="Esc 关闭" VerticalAlignment="Center" />
                <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="存入历史" IsEnabled="False"
                        FontSize="{DynamicResource Size.Caption}" Padding="10,4" Margin="0,0,6,0"
                        Cursor="Hand" Click="OnSaveToHistory"
                        ToolTip="译文存为一条记录，并关联原文条目"/>
                <Button x:Name="SpeakButton" DockPanel.Dock="Right" Content="🔊 朗读"
                        FontSize="{DynamicResource Size.Caption}" Padding="10,4" Margin="0,0,6,0"
                        Cursor="Hand" Click="OnSpeak"
                        ToolTip="朗读译文；朗读中再点一次即停"/>
                <Button x:Name="CopyButton" DockPanel.Dock="Right" Content="复制译文"
                        FontSize="{DynamicResource Size.Caption}" Padding="10,4" Cursor="Hand"
                        Click="OnCopy" />
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
