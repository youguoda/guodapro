<Window x:Class="ListSpike.ListSpikeWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ListSpike"
        Title="Shiyu list spike"
        Width="420" Height="760"
        WindowStartupLocation="CenterScreen"
        Background="#FFF5F6F8">
    <!--
      Spike for issue 02: virtualization + variable-height rows + pinned rows
      + per-row hover animation, all at once.

      Layout answer under test: the pinned region is a separate non-virtualized
      list STACKED above the scrolling region, not overlaid on it. With an
      opaque background the two are visually equivalent — scrolling content is
      clipped exactly at the pinned region's bottom edge either way — and
      stacking needs no scroll synchronization between two regions.
    -->
    <Window.Resources>

        <!--
          The tray buttons' look. Their motion deliberately lives in code
          (TrayStrip) instead of style storyboards: a storyboard in a style
          cannot be torn down when VirtualizationMode=Recycling hands the
          container to another row.
        -->
        <Style x:Key="TrayButton" TargetType="Button">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#FF374151"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="5" Background="#FFE8EDF5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FFD5DFF0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Row container: plain, the card visuals live in the item template. -->
        <Style TargetType="{x:Type local:CardContainer}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type local:CardContainer}">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="CardTemplate" DataType="{x:Type local:CardData}">
            <Border x:Name="Card" CornerRadius="8"
                    Background="#FFFFFFFF" BorderBrush="#FFE5E7EB" BorderThickness="1"
                    Padding="10,8" ClipToBounds="False"
                    MouseEnter="OnCardMouseEnter" MouseLeave="OnCardMouseLeave"
                    MouseLeftButtonDown="OnCardClick">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <local:TrayStrip DockPanel.Dock="Right" Margin="8,0,0,0"/>
                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#FF4B5563" VerticalAlignment="Center"/>
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <TextBlock x:Name="TextBody" FontSize="13" TextWrapping="Wrap"
                                   Foreground="#FF111827" Text="{Binding Body}"/>
                        <Border x:Name="ImageBody" CornerRadius="4" Background="#FFC7D2FE"
                                Height="{Binding ImageHeight}"/>
                        <ItemsControl x:Name="FilesBody" ItemsSource="{Binding Files}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,1">
                                        <TextBlock Text="档" FontSize="11" Foreground="#FF6B7280"
                                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding}" FontSize="12" Foreground="#FF374151"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Text">
                    <Setter TargetName="ImageBody" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="FilesBody" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Image">
                    <Setter TargetName="TextBody" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="FilesBody" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Files">
                    <Setter TargetName="TextBody" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="ImageBody" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="#FFEFF6FF"/>
                    <Setter TargetName="Card" Property="BorderBrush" Value="#FFBFDBFE"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Border x:Name="PinnedHost" DockPanel.Dock="Top"
                Background="#FFF5F6F8" Padding="8,8,8,2">
            <StackPanel>
                <TextBlock Text="置顶" FontSize="11" Foreground="#FF6B7280" Margin="2,0,0,4"/>
                <ItemsControl x:Name="PinnedList" ItemTemplate="{StaticResource CardTemplate}"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#FFEBEEF3" Padding="10,6">
            <TextBlock x:Name="Status" FontSize="11" Foreground="#FF6B7280"
                       Text="悬停卡片看按钮挤入 · 点卡片选中 · 「钉」置顶/取消"/>
        </Border>

        <local:CardList x:Name="MainList"
                        ItemTemplate="{StaticResource CardTemplate}"
                        Background="Transparent" BorderThickness="0"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        VirtualizingStackPanel.IsVirtualizing="True"
                        VirtualizingStackPanel.VirtualizationMode="Recycling"
                        VirtualizingStackPanel.ScrollUnit="Pixel"
                        VirtualizingPanel.CacheLength="1"
                        VirtualizingPanel.CacheLengthUnit="Page"/>
    </DockPanel>
</Window>
